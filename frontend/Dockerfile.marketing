# Outlogik website (Angular, server-rendered on Node). Built by DigitalOcean App Platform from
# the frontend directory; see docs/DEPLOYMENT.md.
FROM node:22-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# Public addresses baked into the build (canonical URLs, sitemap, "Log in"). Staging overrides them.
ARG OL_SITE_URL=https://outlogik.com
ARG OL_APP_URL=https://app.outlogik.com
RUN npx ng build marketing --define "OL_SITE_URL='${OL_SITE_URL}'" --define "OL_APP_URL='${OL_APP_URL}'"

FROM node:22-alpine
ENV NODE_ENV=production PORT=8080
WORKDIR /app
# The server bundle includes its dependencies, so no node_modules are needed at runtime.
COPY --from=build --chown=node:node /src/dist/marketing ./dist/marketing
USER node
EXPOSE 8080
CMD ["node", "dist/marketing/server/server.mjs"]
