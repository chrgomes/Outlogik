# Copy to .env and adjust. Values below match docker-compose.yml for local development.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://outlogik:outlogik@localhost:5432/outlogik
REDIS_URL=redis://localhost:6379/0

# Public URL of the Angular app, used to build links in emails.
# Production: https://app.outlogik.com
FRONTEND_URL=http://localhost:4200

# Public website. Its forms may only post from this origin (add a staging site, comma-separated,
# in PUBLIC_FORM_EXTRA_ORIGINS). Also used for links in newsletter emails.
# Production: https://outlogik.com
SITE_URL=http://localhost:4300
PUBLIC_FORM_EXTRA_ORIGINS=

# Who is emailed about new consultation requests and contact messages (comma-separated).
# Leave empty to turn notifications off; leads are still stored for the admin area.
LEAD_NOTIFICATION_EMAILS=

# Cookies. Keep COOKIE_SECURE=true in any deployed environment.
# Browsers accept Secure cookies on http://localhost, so true also works in local development.
COOKIE_SECURE=true

# Sessions
SESSION_IDLE_TIMEOUT_MINUTES=1440
SESSION_ABSOLUTE_LIFETIME_HOURS=336

# Sign-up: "invite_only" (Outlogik invites its clients and staff) or "open" (anyone can create
# an organization). Bootstrap the first organization with: python -m app.cli create-organization
SIGNUP_MODE=invite_only

# Email. "smtp" sends to Mailpit locally (web inbox at http://localhost:8025).
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# Production: a sender on the real domain, e.g. Outlogik <no-reply@outlogik.com>, with SPF,
# DKIM and DMARC set up in the domain's DNS (GoDaddy) for the email provider.
EMAIL_FROM=Outlogik <no-reply@outlogik.local>

# Background jobs: "inline" runs them straight away (development); "queue" sends them to the
# Celery worker (staging, production: celery -A app.worker worker --beat). JOBS_QUEUE must differ
# between environments that share a Redis.
JOBS_MODE=inline
JOBS_QUEUE=outlogik

# Website audits. Google PageSpeed Insights key (optional; audits say "not connected" without
# it). CRAWLER_ALLOW_PRIVATE lets audits fetch local addresses: for trying audits against a
# local site only, never in production.
PAGESPEED_API_KEY=
CRAWLER_ALLOW_PRIVATE=false

# Google Analytics and Search Console (Integrations page). Leave the client ID empty and the page
# says Google isn't set up. The redirect URI defaults to {FRONTEND_URL}/api/v1/integrations/google/callback.
# INTEGRATIONS_ENCRYPTION_KEY encrypts stored Google tokens: required in production when Google is
# set up; development uses a fixed key. Generate: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
INTEGRATIONS_ENCRYPTION_KEY=
